# Leech's own passkeys (ADR 0009). A target of its own so //chrome/browser/webauthn can ask it first without
# depending on //chrome/browser/ui.
source_set("passkeys") {
  sources = [
    "leech_passkey_bridge.cc",
    "leech_passkey_bridge.h",
    "leech_passkey_proxy.cc",
    "leech_passkey_proxy.h",
    "leech_passkey_responses.cc",
    "leech_passkey_responses.h",
    "leech_passkey_store.cc",
    "leech_passkey_store.h",
  ]
  deps = [
    "//base",
    "//components/cbor",
    "//content/public/browser",
    "//crypto",
    "//device/fido",
    "//third_party/blink/public/mojom:authenticator_mojo_bindings",
    "//third_party/boringssl",
    "//url",
  ]
}

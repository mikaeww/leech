+// Leech: address values are encrypted like card numbers, so a copied "Web Data"
+// doesn't hand them out. Rows written before are TEXT and still read until
+// EncryptPlainAddressValues() encrypts them at start.
+bool BindEncryptedValue(sql::Statement& s,
+                        int column,
+                        const std::u16string& value,
+                        const os_crypt_async::Encryptor& encryptor) {
+  std::string encrypted;
+  if (!encryptor.EncryptString16(value, &encrypted)) {
+    return false;
+  }
+  s.BindBlob(column, std::move(encrypted));
+  return true;
+}
+
+std::optional<std::u16string> ColumnEncryptedValue(
+    sql::Statement& s,
+    int column,
+    const os_crypt_async::Encryptor& encryptor) {
+  if (s.GetColumnType(column) != sql::ColumnType::kBlob) {
+    return s.ColumnString16(column);
+  }
+  std::u16string value;
+  if (!encryptor.DecryptString16(s.ColumnBlobAsString(column), &value)) {
+    return std::nullopt;
+  }
+  return value;
+}
+
+// Leech: encrypts the values written before encryption, all or none. A failure
+// leaves them readable as they were and doesn't stop the database from opening.
+void EncryptPlainAddressValues(sql::Database* db,
+                               const os_crypt_async::Encryptor* encryptor) {
+  if (!encryptor) {
+    return;
+  }
+  sql::Transaction transaction(db);
+  if (!transaction.Begin()) {
+    LOG(ERROR) << "Autofill: can't encrypt stored addresses: no transaction";
+    return;
+  }
+  sql::Statement select(db->GetUniqueStatement(
+      "SELECT rowid, value FROM address_type_tokens "
+      "WHERE typeof(value) = 'text'"));
+  std::vector<std::pair<int64_t, std::u16string>> plain;
+  while (select.Step()) {
+    plain.emplace_back(select.ColumnInt64(0), select.ColumnString16(1));
+  }
+  for (const auto& [row, value] : plain) {
+    sql::Statement update(db->GetUniqueStatement(
+        "UPDATE address_type_tokens SET value = ? WHERE rowid = ?"));
+    if (!BindEncryptedValue(update, 0, value, *encryptor)) {
+      LOG(ERROR) << "Autofill: can't encrypt stored addresses";
+      return;
+    }
+    update.BindInt64(1, row);
+    if (!update.Run()) {
+      LOG(ERROR) << "Autofill: can't write encrypted addresses";
+      return;
+    }
+  }
+  if (!transaction.Commit()) {
+    LOG(ERROR) << "Autofill: can't commit encrypted addresses";
+  }
+}

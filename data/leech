#!/bin/sh
# Starts Leech: an installed copy (<prefix>/lib/leech beside this <prefix>/bin), else the checkout and its build.
installed="$(dirname "$(readlink -f "$0")")/../lib/leech"
if [ -x "$installed/chrome" ]; then
  # The UI ships beside the binary as leech-ui/, where Chromium looks without LEECH_UI_DIR.
  LEECH_CHROMIUM="$installed"
else
  LEECH_HOME="${LEECH_HOME:-$HOME/Projekte/Apps/leech}"
  LEECH_CHROMIUM="${LEECH_CHROMIUM:-$HOME/Projekte/Apps/leech-chromium/src/out/Leech}"
  export LEECH_UI_DIR="$LEECH_HOME/ui"
fi
# Chromium names its desktop file from this when it sets or checks the default browser; unset, it names
# chromium-browser.desktop, and "Make default" makes some other browser the default.
export CHROME_DESKTOP=dev.mikaeww.Leech.desktop
data="${XDG_DATA_HOME:-$HOME/.local/share}/leech"
store="$data/chromium/Default/Leech"

# First start after the Electron build: bring its tabs, settings and history along, once.
if [ ! -d "$store" ]; then
  mkdir -p "$store"
  for name in settings session history icons hidden bookmarks; do
    [ -f "$data/$name.json" ] && cp "$data/$name.json" "$store/"
  done
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}/leech"
mkdir -p "$state"
# The last run's log stays one start longer, so a problem that ends a session can still be read.
[ -f "$state/leech.log" ] && mv -f "$state/leech.log" "$state/leech.log.1"
# LEECH_DEBUG=1 opens DevTools on localhost for measuring; off by default, since any local
# program could then drive the browser.
debug=""
[ -n "$LEECH_DEBUG" ] && debug="--remote-debugging-port=9222"
exec "$LEECH_CHROMIUM/chrome" --user-data-dir="$data/chromium" --class=dev.mikaeww.Leech \
  --enable-logging=stderr $debug "$@" 2>"$state/leech.log"
